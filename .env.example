# Hosted checkout links (Stripe Payment Links, Lemon Squeezy, Paddle...).
# Leave blank and that plan's button sends the visitor to the early-access list
# instead, tagged with the plan they clicked.
VITE_CHECKOUT_STUDIO_MONTHLY=
VITE_CHECKOUT_STUDIO_YEARLY=
VITE_CHECKOUT_AGENCY_MONTHLY=
VITE_CHECKOUT_AGENCY_YEARLY=

# Where signups go. A URL that accepts a POST — NOT an email address.
# Receives { email, source, plan, at }.
#   Google Sheet : deploy scripts/lead-sink.gs (see README) and paste its /exec URL
#   Formspree    : https://formspree.io/f/xxxxxxxx
#   Your own API : https://yoursite.com/api/lead
# If this is blank, signups are kept in the visitor's browser and never reach you.
VITE_SIGNUP_ENDPOINT=

# Wire format: "json" (default) or "form".
# Google Apps Script CANNOT answer the CORS preflight that JSON triggers — set
# this to "form" for the Google Sheet route, or every signup fails in the browser.
VITE_SIGNUP_FORMAT=json
