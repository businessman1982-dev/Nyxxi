# Hosted checkout links (Stripe Payment Links, Lemon Squeezy, Paddle...).
# Leave blank and the pricing buttons fall back to the email capture form.
VITE_CHECKOUT_STUDIO_MONTHLY=
VITE_CHECKOUT_STUDIO_YEARLY=
VITE_CHECKOUT_AGENCY_MONTHLY=
VITE_CHECKOUT_AGENCY_YEARLY=

# POST target for waitlist / signup emails (Formspree, Buttondown, your own API).
# Receives { email, source, plan, at } as JSON. If unset, signups are kept in the
# visitor's browser only and never reach you.
VITE_SIGNUP_ENDPOINT=
